{
  "name": "@crclaunch/crc20-protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser.js",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node build-browser.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "lint": "eslint *.ts *.mjs --max-warnings=0 --no-warn-ignored"
  },
  "dependencies": {
    "tiny-secp256k1": "^2.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.7.2"
  }
}
