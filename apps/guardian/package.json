    "@crclaunch/cove-mainnet": "workspace:*",
    "@crclaunch/cove-vault": "workspace:*",
    "@crclaunch/cove-wire": "workspace:*",
    "@crclaunch/db": "workspace:*",
    "bitcoinjs-lib": "^6.1.7",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.36.4",
    "envalid": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "ecpair": "^2.1.0",
